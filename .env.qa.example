# QA environment reference for worlds-api
# Copy this file to `.env.qa` and fill in real values.
# These values are used for local scripts and ad-hoc commands against QA.
# Runtime secrets on the QA Worker are set via `wrangler secret put --env qa`.

# Worlds data libSQL database URL.
LIBSQL_URL="libsql://worlds-api-qa-ethanthatonekid.aws-us-west-2.turso.io"

# Auth token for remote libSQL.
# Create with: turso db tokens create worlds-api-qa
LIBSQL_AUTH_TOKEN="<qa-libsql-token>"

# Admin key used by wazoo-api for provisioning and API-key management.
# Must match the WORLDS_API_ADMIN_KEY secret configured on the wazoo-api-qa Worker.
WORLDS_ADMIN_KEY="<qa-admin-key>"

# Turso platform credentials used to provision and destroy per-world databases.
# Use a group-scoped token with least privilege.
TURSO_ORG="ethanthatonekid"
TURSO_GROUP="wazoo"
TURSO_PLATFORM_API_TOKEN="<turso-platform-token>"

# Org-wide cap on Turso databases for the current plan. Creation errors with
# DATABASE_LIMIT_REACHED once the org is at capacity. Defaults to 100.
MAX_DATABASES="100"

# Environment label used in the Turso database name.
WAZOO_ENV="qa"
