{
  "name": "worlds-api",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc",
    "start": "node dist/server.js",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "openapi:check": "vitest run tests/openapi-doc.test.ts",
    "health:local": "node scripts/local-health.mjs",
    "canary:prod": "node scripts/prod-canary.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier \"src/**/*.ts\" \"tests/**/*.ts\" --write",
    "format:check": "prettier \"src/**/*.ts\" \"tests/**/*.ts\" --check",
    "lint": "eslint . --max-warnings 0",
    "test:coverage": "vitest run --coverage",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.17.1",
    "@hono/zod-openapi": "^1.5.1",
    "@langchain/core": "^1.2.3",
    "@rdfjs/types": "^2.0.1",
    "@std/ulid": "npm:@jsr/std__ulid@^1.0.0",
    "@wazoo/sparql-engine": "npm:@jsr/wazoo__sparql-engine@^0.4.4",
    "@worlds/cloudflare": "npm:@jsr/worlds__cloudflare@^0.13.0",
    "@worlds/sdk": "npm:@jsr/worlds__sdk@^0.9.0",
    "@worlds/sqlite": "npm:@jsr/worlds__sqlite@^0.6.0",
    "hono": "^4.10.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260718.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
