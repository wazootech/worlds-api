# Production environment reference for worlds-api
# Copy this file to `.env.production` and fill in real values.
# These values are used for local scripts and ad-hoc commands against production.
# Runtime secrets on the production Worker are set via `wrangler secret put`.

# Worlds data libSQL database URL.
LIBSQL_URL="libsql://worlds-api-prod-ethanthatonekid.aws-us-west-2.turso.io"

# Auth token for remote libSQL.
# Create with: turso db tokens create worlds-api-prod
LIBSQL_AUTH_TOKEN="<prod-libsql-token>"

# Admin key used by wazoo-api for provisioning and API-key management.
# Must match the WORLDS_API_ADMIN_KEY secret configured on the wazoo-api production Worker.
WORLDS_ADMIN_KEY="<prod-admin-key>"
