{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "types": ["node", "@cloudflare/workers-types"],
    "paths": {
      "@worlds/cloudflare": ["./src/types/worlds-cloudflare.d.ts"],
      "@worlds/sdk": ["./src/types/worlds-cloudflare.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
